# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# --- required ----------------------------------------------------------------
# Discord bot token: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Riot API key: https://developer.riotgames.com
# Development keys EXPIRE EVERY 24 HOURS. Apply for a personal key for anything
# long-running, or expect to paste a new one here daily.
RIOT_API_KEY=

# --- optional ----------------------------------------------------------------
# Where the SQLite file lives (default: vibecheck.sqlite3 next to bot.py).
#VIBECHECK_DB=vibecheck.sqlite3

# How often to sweep match history, in seconds. A dev key allows 100 requests /
# 2 min, so 120 comfortably covers ~15-20 linked players.
#VIBECHECK_POLL_SECONDS=120

# --- local capture (macOS + Windows) -----------------------------------------
# Set to 1 when the bot runs on the SAME machine as your League client. It reads
# the client's local API, which captures games the public API refuses to return
# (ARAM: Mayhem, custom lobbies) and prompts within seconds instead of minutes.
# Leave unset when hosting the bot on a server.
#VIBECHECK_LCU=1

# How often to check the client's gameflow phase. Local call, so this is cheap.
#VIBECHECK_LCU_POLL_SECONDS=5

# Only needed for a non-default League install; otherwise found automatically.
# macOS:   /Applications/League of Legends.app/Contents/LoL/lockfile
# Windows: C:\Riot Games\League of Legends\lockfile
#VIBECHECK_LCU_LOCKFILE=
